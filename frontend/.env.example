# Local Vite: point at the API gateway.
VITE_API_BASE_URL=http://localhost:8080
# Production Docker image: leave empty so the browser uses same-origin /auth and /api
# (nginx proxies those paths to the gateway). Example build:
#   docker build --build-arg VITE_API_BASE_URL= ...
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
